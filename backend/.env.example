# Copy this file to .env and adjust values for local development or deployment.
# backend/.env is loaded automatically at startup; real environment variables take precedence.

# "development" relaxes the SECRET_KEY check and allows the demo seed. Anything else (the default
# is "production") refuses to start without a strong SECRET_KEY.
APP_ENV=development
# Production: 32+ random chars, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./app.db
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_MAPS_API_KEY=
AYANAMSA=yukteswar
NODE_TYPE=mean
HOUSE_SYSTEM=whole_sign
CACHE_ENABLED=true
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com
